# ── Discord ──
# Bot token from the Discord Developer Portal → your app → Bot.
DISCORD_TOKEN=
# Application (client) ID — Developer Portal → General Information.
DISCORD_APP_ID=
# Optional: register slash commands to one guild instantly (dev). Leave blank
# for global commands (can take up to an hour to appear).
DISCORD_GUILD_ID=

# ── Shared database (SAME Neon DB as the Telegram bot) ──
DATABASE_URL=

# ── Firebase Storage (receipts) — same bucket as the Telegram side ──
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
